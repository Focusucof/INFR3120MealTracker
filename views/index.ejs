<!DOCTYPE html>
<html>
<%- include('components/head') %>

  <body class="d-flex flex-column min-vh-100">
    <!-- pass active page state to navbar -->
    <%- include('components/navbar', { active: 'home' }) %>

      <main class="flex-grow-1">
        <section class="container py-5 my-md-5">
          <div class="row align-items-center g-5">
            <div class="col-lg-6">
              <p class="text-danger fw-semibold text-uppercase small mb-2">Calorie Tracking</p>
              <h1 class="display-5 fw-bold mb-3">Track what you eat.</h1>
              <p class="lead text-secondary mb-4">
                Log your meals, keep an eye on your calories, and hit your nutritional goals in no time.
              </p>
              <div class="d-flex gap-2">
                <a class="btn btn-dark rounded-0 fw-semibold px-4 py-2" href="/meals/add">Add a meal</a>
                <a class="btn btn-outline-dark rounded-0 fw-semibold px-4 py-2" href="/meals">View meals</a>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="border bg-white p-4">
                <div class="d-flex justify-content-between align-items-baseline mb-3">
                  <h2 class="h6 fw-semibold mb-0">Today</h2>
                  <span class="text-secondary small">1,450 / 2,000 cal</span>
                </div>
                <div class="progress rounded-0 mb-4" style="height: 6px;">
                  <div class="progress-bar bg-danger" style="width: 73%;"></div> <!-- progress bar -->
                </div>
                
                <ul class="list-group list-group-flush">
                  <li class="list-group-item d-flex justify-content-between px-0">
                    <span><span class="text-secondary small d-block">Breakfast</span>Oatmeal with berries</span>
                    <span class="fw-semibold">320 cal</span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between px-0">
                    <span><span class="text-secondary small d-block">Lunch</span>Chicken wrap</span>
                    <span class="fw-semibold">540 cal</span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between px-0">
                    <span><span class="text-secondary small d-block">Dinner</span>Salmon and rice</span>
                    <span class="fw-semibold">590 cal</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </section>

      </main>
  </body>

</html>